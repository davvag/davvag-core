{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for Xdebug (XAMPP/Apache)",
            "type": "php",
            "request": "launch",
            "hostname": "127.0.0.1",
            "port": 9003
        },
        {
            "name": "Launch current PHP script (XAMPP)",
            "type": "php",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "runtimeExecutable": "C:\\xampp\\php\\php.exe",
            "runtimeArgs": [
                "-dxdebug.mode=debug,develop",
                "-dxdebug.start_with_request=yes",
                "-dxdebug.client_host=127.0.0.1",
                "-dxdebug.client_port=9003"
            ],
            "hostname": "127.0.0.1",
            "port": 9003
        },
        {
            "name": "Launch PHP built-in server (XAMPP)",
            "type": "php",
            "request": "launch",
            "runtimeExecutable": "C:\\xampp\\php\\php.exe",
            "runtimeArgs": [
                "-dxdebug.mode=debug,develop",
                "-dxdebug.start_with_request=yes",
                "-dxdebug.client_host=127.0.0.1",
                "-dxdebug.client_port=9003",
                "-S",
                "127.0.0.1:8080"
            ],
            "program": "",
            "cwd": "${workspaceFolder}",
            "hostname": "127.0.0.1",
            "port": 9003,
            "serverReadyAction": {
                "pattern": "Development Server \\(http://127.0.0.1:([0-9]+)\\) started",
                "uriFormat": "http://127.0.0.1:%s",
                "action": "openExternally"
            }
        }
    ]
}
